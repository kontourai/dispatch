{
  "name": "@kontourai/dispatch",
  "version": "0.1.0",
  "description": "Policy-aware model execution with portable routing, budgets, fallbacks, and receipts",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "dispatch": "bin/dispatch.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./datum": {
      "types": "./dist/src/datum.d.ts",
      "import": "./dist/src/datum.js"
    },
    "./bearing": {
      "types": "./dist/src/bearing.d.ts",
      "import": "./dist/src/bearing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "verify": "npm run typecheck && npm test && npm pack --dry-run",
    "veritas:readiness": "veritas readiness --working-tree"
  },
  "devDependencies": {
    "@kontourai/bearing": "^0.2.0",
    "@kontourai/datum": "^0.7.0",
    "@kontourai/veritas": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@kontourai/bearing": "^0.2.0",
    "@kontourai/datum": "^0.7.0"
  },
  "peerDependenciesMeta": {
    "@kontourai/bearing": {
      "optional": true
    },
    "@kontourai/datum": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontourai/dispatch.git"
  },
  "dependencies": {
    "@kontourai/relay": "^0.1.0"
  }
}
